<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1714"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="36dp"
    android:paddingEnd="28dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="Audrix Relay"
            android:src="@drawable/logo_mark" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audrix"
                android:textColor="#E4DCCF"
                android:textSize="36sp" />

            <View
                android:layout_width="72dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="#7C3030" />
        </LinearLayout>

        <TextView
            android:id="@+id/lang_en"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:padding="8dp"
            android:text="EN"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/lang_th"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="TH"
            android:textSize="16sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/pcs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:layout_weight="1"
        android:divider="#3A342E"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/latency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E4DCCF"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/ms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="10dp"
            android:text="ms"
            android:textColor="#8A8074"
            android:textSize="20sp" />
    </LinearLayout>

    <Button
        android:id="@+id/disconnect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#241816"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="หยุด"
        android:textColor="#E4DCCF"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#8A8074"
        android:textSize="16sp" />
</LinearLayout>
